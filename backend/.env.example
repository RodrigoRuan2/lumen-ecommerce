# =====================================================
# Backend Environment Variables
# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env (já está no .gitignore).
# =====================================================

# Porta do servidor Express (opcional, padrão: 5000)
PORT=5000

# 'development' habilita mensagens de erro detalhadas na resposta HTTP.
# Em 'production', erros viram mensagem genérica.
NODE_ENV=development

# Origem permitida no CORS (opcional). Localhost:3000 e :4173 já são aceitos por padrão.
FRONTEND_URL=http://localhost:3000

# ----------- Supabase (obrigatório) -----------
# Project URL — encontrado em Project Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key — encontrado em Project Settings > API
# ATENÇÃO: bypassa RLS. Mantenha em segredo absoluto. Nunca exponha ao frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------- Legado (não utilizado atualmente) -----------
# MongoDB foi substituído por Supabase. Mantido apenas se quiser reativar.
# MONGODB_URI=mongodb://localhost:27017/ecommerce
