# =====================================================
# Frontend Environment Variables (Vite)
# Copie este arquivo para .env e preencha com valores reais.
# Variáveis prefixadas com VITE_ são embutidas no bundle —
# use apenas chaves públicas, nunca segredos.
# =====================================================

# Supabase Project URL (mesmo do backend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (chave PÚBLICA, encontrada em Project Settings > API)
# Esta chave respeita RLS — segura para expor no frontend.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
